{
  "name": "genosdb",
  "version": "0.31.1",
  "description": "GenosDB (GDB): distributed graph database in real-time, peer-to-peer, scalable storage - efficient querying of complex relationships.",
  "main": "dist/index.js",
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.min.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun esbun.js",
    "dev": "bun run --watch",
    "test": "bash tests/run.sh",
    "test:types": "bunx --package typescript tsc -p tests/types",
    "server": "bun dist/genossrv.min.js"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estebanrfp/gdb.git"
  },
  "keywords": [
    "GenosDB",
    "genosdb",
    "GenosRTC",
    "genosrtc",
    "gdb",
    "database",
    "graph",
    "graph-database",
    "crdt",
    "CRDT",
    "p2p",
    "peer-to-peer",
    "webrtc",
    "decentralized",
    "distributed",
    "real-time",
    "realtime",
    "replication",
    "local-first",
    "offline-first",
    "rbac",
    "zero-trust",
    "cellular-mesh",
    "nostr",
    "opfs"
  ],
  "author": {
    "name": "Esteban Fuster Pozzi",
    "email": "estebanrfp@gmail.com",
    "url": "https://github.com/estebanrfp"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/estebanrfp/gdb/issues"
  },
  "homepage": "https://github.com/estebanrfp/gdb#readme",
  "devDependencies": {
    "@msgpack/msgpack": "3.1.2",
    "ethers": "6.15.0",
    "pako": "2.1.0",
    "eslint": "9.39.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-promise": "7.2.1"
  },
  "overrides": {
    "ws": ">=8.21.0 <9"
  },
  "pnpm": {
    "overrides": {
      "ws": ">=8.21.0 <9"
    }
  }
